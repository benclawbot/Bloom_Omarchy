#!/usr/bin/env python3
"""Bloom session entry point with silent destination-aware app launching.

The session core remains unchanged. This shim overrides only application launch
so restored windows are born on their saved Hyprland workspace instead of
briefly appearing on the user's active workspace before relocation.
"""

from __future__ import annotations

import os
import pathlib
import shlex
import subprocess
import sys
from typing import Any

CORE = pathlib.Path(__file__).with_name("bloom-session-core")
_runtime_name = __name__

# Execute the existing manager in this module namespace so its functions retain
# the same globals/mocking behavior as the original single-file implementation.
# A temporary non-main name prevents the core's CLI footer from firing before
# this shim installs the destination-aware launch override.
globals()["__name__"] = "bloom_session_core"
exec(compile(CORE.read_text(encoding="utf-8"), str(CORE), "exec"), globals(), globals())
globals()["__name__"] = _runtime_name


def launch_target(target: dict[str, Any]) -> bool:
    launch = target.get("launch") if isinstance(target.get("launch"), dict) else {}
    desktop_id = str(launch.get("desktopId", ""))
    executable = str(launch.get("executable", ""))

    command: list[str] = []
    if valid_desktop_id(desktop_id):
        command = ["gtk-launch", desktop_id]
    else:
        path = pathlib.Path(executable)
        if path.is_absolute() and path.is_file() and os.access(path, os.X_OK):
            command = [str(path)]

    if not command:
        return False

    try:
        workspace = max(1, int(target.get("workspace", 1) or 1))
    except (TypeError, ValueError):
        workspace = 1

    command_text = " ".join(shlex.quote(part) for part in command)
    try:
        subprocess.run(
            [
                "hyprctl",
                "dispatch",
                "exec",
                f"[workspace {workspace} silent] {command_text}",
            ],
            check=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3,
        )
        return True
    except (OSError, subprocess.SubprocessError):
        return False


# restore_workspace resolves launch_target dynamically from this same globals
# dictionary. Its existing client matcher and movetoworkspacesilent call remain
# the fallback for applications that fork or ignore Hyprland's one-shot rule.
if _runtime_name == "__main__":
    raise SystemExit(main(sys.argv))
