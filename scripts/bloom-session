#!/usr/bin/env python3
"""Bloom session entry point with silent destination-aware app launching.

The session core remains unchanged. This shim overrides only application launch
so restored windows are born on their saved Hyprland workspace instead of
briefly appearing on the user's active workspace before relocation.
"""

from __future__ import annotations

import os
import pathlib
import runpy
import shlex
import subprocess
import sys
from typing import Any

CORE = pathlib.Path(__file__).with_name("bloom-session-core")
core = runpy.run_path(str(CORE), run_name="bloom_session_core")

# Preserve the public surface of the original script for focused tests and any
# local tooling that imports bloom-session rather than only invoking its CLI.
for name, value in core.items():
    if name not in {"__name__", "__file__", "__package__", "__loader__", "__spec__"}:
        globals()[name] = value


def launch_target(target: dict[str, Any]) -> bool:
    launch = target.get("launch") if isinstance(target.get("launch"), dict) else {}
    desktop_id = str(launch.get("desktopId", ""))
    executable = str(launch.get("executable", ""))

    command: list[str] = []
    if core["valid_desktop_id"](desktop_id):
        command = ["gtk-launch", desktop_id]
    else:
        path = pathlib.Path(executable)
        if path.is_absolute() and path.is_file() and os.access(path, os.X_OK):
            command = [str(path)]

    if not command:
        return False

    try:
        workspace = max(1, int(target.get("workspace", 1) or 1))
    except (TypeError, ValueError):
        workspace = 1

    command_text = " ".join(shlex.quote(part) for part in command)
    try:
        subprocess.run(
            [
                "hyprctl",
                "dispatch",
                "exec",
                f"[workspace {workspace} silent] {command_text}",
            ],
            check=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3,
        )
        return True
    except (OSError, subprocess.SubprocessError):
        return False


# Functions created by runpy resolve their globals through this dictionary, so
# replacing the launch function here changes only the app-spawn step. The core
# still performs client matching and movetoworkspacesilent afterward as a
# fallback for applications that fork or ignore Hyprland's one-shot exec rule.
core["launch_target"] = launch_target

if __name__ == "__main__":
    raise SystemExit(core["main"](sys.argv))
